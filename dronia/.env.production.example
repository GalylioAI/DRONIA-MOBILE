# Production API URL - Replace with your deployed backend
API_BASE_URL=https://api.dronia.tn

# Environment
ENVIRONMENT=production

# MongoDB Configuration (use production cluster)
MONGODB_URI=mongodb+srv://prod_user:prod_password@production-cluster.mongodb.net/dronia?retryWrites=true&w=majority

# JWT Configuration (generate a secure random 64-char secret)
JWT_SECRET=REPLACE_WITH_SECURE_64_CHARACTER_SECRET_KEY_FOR_PRODUCTION

# OpenWeather API Configuration
OPENWEATHER_API_KEY=your_production_openweather_key
